{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.theageofgenz.com"
        }
      ],
      "destination": "https://theageofgenz.com/:path*",
      "statusCode": 308
    },
    {
      "source": "/:section(tech|pop-media|science-discovery|global|politics|business-economy|crime-justice|sports|trending|opinion|ai|culture|world|insights|memes|donate|support|subscribe|privacy|contact|terms|about|search|login|signup|forgot-password|unsubscribe|home)",
      "destination": "/:section/",
      "statusCode": 308
    },
    {
      "source": "/category/:slug",
      "destination": "/category/:slug/",
      "statusCode": 308
    },
    {
      "source": "/articles/:slug",
      "destination": "/articles/:slug/",
      "statusCode": 308
    },
    {
      "source": "/article/:slug",
      "destination": "/articles/:slug/",
      "statusCode": 308
    },
    {
      "source": "/article/:slug/",
      "destination": "/articles/:slug/",
      "statusCode": 308
    },
    {
      "source": "/s/:code",
      "destination": "https://ageofgenz-backend.onrender.com/s/:code/",
      "statusCode": 307
    },
    {
      "source": "/s/:code/",
      "destination": "https://ageofgenz-backend.onrender.com/s/:code/",
      "statusCode": 307
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://ageofgenz-backend.onrender.com/sitemap.xml"
    },
    {
      "source": "/sitemap-news.xml",
      "destination": "https://ageofgenz-backend.onrender.com/sitemap-news.xml"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "https://ageofgenz-backend.onrender.com/sitemap-index.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://ageofgenz-backend.onrender.com/robots.txt"
    },
    {
      "source": "/rss.xml",
      "destination": "https://ageofgenz-backend.onrender.com/rss.xml"
    },
    {
      "source": "/articles/:slug/",
      "destination": "/api/article-proxy?slug=:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ageofgenz-backend.onrender.com/api/:path*"
    },
    {
      "source": "/category/:slug/",
      "destination": "/__shell/index.html"
    },
    {
      "source": "/reset-password/:path*",
      "destination": "/__shell/index.html"
    },
    {
      "source": "/studio",
      "destination": "/__shell/index.html"
    },
    {
      "source": "/studio/:path*",
      "destination": "/__shell/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=86400"
        }
      ]
    },
    {
      "source": "/studio(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap-news.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/article-proxy.js": {
      "maxDuration": 15
    }
  }
}
